rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un document par téléphone, identifié de façon anonyme.
    match /votes/{uid} {
      function isAdmin() {
        // Remplacez par l'adresse Google de l'administrateur si besoin.
        return request.auth != null
          && request.auth.token.email == 'lechariot.contact@gmail.com'
          && request.auth.token.email_verified == true;
      }
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['favs', 'plans', 'updatedAt'])
          && d.favs is list && d.favs.size() <= 50
          && d.plans is list && d.plans.size() <= 200;
      }

      allow create, update: if isOwner() && validData();
      allow delete: if isOwner();
      allow read: if isOwner() || isAdmin();
    }

    // Un document par téléphone abonné aux notifications (anonyme) : adresse de notification,
    // favoris et « J'y vais » pour les rappels. Lu seulement par l'envoi automatique (GitHub).
    match /tokens/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'favs', 'plans', 'updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() < 500
        && request.resource.data.favs is list && request.resource.data.favs.size() <= 50
        && request.resource.data.plans is list && request.resource.data.plans.size() <= 200;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
