rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un document par téléphone, identifié de façon anonyme.
    match /votes/{uid} {
      function isAdmin() {
        // Remplacez par l'adresse Google de l'administrateur si besoin.
        return request.auth != null
          && request.auth.token.email == 'lechariot.contact@gmail.com'
          && request.auth.token.email_verified == true;
      }
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['favs', 'plans', 'updatedAt'])
          && d.favs is list && d.favs.size() <= 50
          && d.plans is list && d.plans.size() <= 200;
      }

      allow create, update: if isOwner() && validData();
      allow delete: if isOwner();
      allow read: if isOwner() || isAdmin();
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
